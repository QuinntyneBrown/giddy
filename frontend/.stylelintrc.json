{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch"
    ],
    "declaration-property-value-allowed-list": { "z-index": ["/^var\\(--z-/"] },
    "selector-class-pattern": null,
    "import-notation": "string"
  }
}
