@startuml
title UML sequence behaviour — Guests — remove with Undo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "RemoveGuestDialog" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "GuestsController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "RemoveGuestHandler" as h
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Remove Ethan Kim (confirm)
page -> ctrl : DELETE /guests/{guestId}
ctrl -> h : RemoveGuestCommand
h -> db : Set RemovedAt
h --> ctrl : 204
ctrl --> page : Toast "Ethan Kim removed" + Undo (8 s)
opt Undo
  page -> ctrl : POST /guests/{guestId}/restore
  ctrl -> h : Restore
  h -> db : Clear RemovedAt
end
@enduml
