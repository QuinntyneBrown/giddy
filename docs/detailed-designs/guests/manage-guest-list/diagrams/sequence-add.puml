@startuml
title UML sequence behaviour — Guests — add a guest
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "AddGuestDialog" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "GuestsController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "AddGuestHandler" as h
  participant "Party" as ent
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Samira Haddad, Rania Haddad, email, mobile
page -> ctrl : POST /api/parties/{id}/guests
ctrl -> h : AddGuestCommand
h -> h : Validate email, Canadian mobile (L2-071)
h -> db : Load party guests
h -> ent : AddGuest
alt duplicate or 60 reached
  ent --> h : Rejected
  h --> ctrl : 409 with reason
else added
  h -> db : Save
  opt send now and invites already sent
    h -> h : Enqueue invitation (status Waiting)
  end
  h --> ctrl : 201
end
ctrl --> page : Result
page --> actor : Row added and counts updated, or error
@enduml
