@startuml
title UML sequence behaviour — Reminders — send to selected guests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "GuestSelectionBar" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "RemindersController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "SendRemindersHandler" as h
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
  queue "Message bus" as bus
end box
actor -> page : Send reminder (3)
page -> ctrl : POST /reminders {guestIds}
ctrl -> h : SendRemindersCommand
h -> db : Last reminded per guest
h -> h : Skip within 48 h
h -> bus : Schedule messages
h --> ctrl : {scheduled: 3, skipped: []}
ctrl --> page : 202
page --> actor : Info toast "Reminder scheduled"
@enduml
