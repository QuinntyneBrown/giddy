@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Deliver email, text and push

Person(parent, "Parent", "Plans kids' birthday parties with Giddy")
System(giddy, "Giddy", "Agentic kids' birthday planner for the GTA")
System_Ext(email, "Email provider", "Sends transactional and marketing email")
System_Ext(sms, "SMS provider", "Sends text messages and receives STOP replies")
System_Ext(push, "Web Push service", "Browser push delivery (VAPID)")

Rel(parent, giddy, "Receives messages from")
Rel(giddy, email, "Calls", "SMTP/HTTPS")
Rel(giddy, sms, "Calls", "HTTPS")
Rel(giddy, push, "Calls", "Web Push")
@enduml
