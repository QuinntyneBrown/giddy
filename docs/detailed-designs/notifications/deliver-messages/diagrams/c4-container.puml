@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Deliver email, text and push

Person(parent, "Parent", "Plans kids' birthday parties with Giddy")
System_Boundary(giddy, "Giddy") {
  Container(api, "Giddy API", "ASP.NET Core", "REST endpoints, SignalR hub, application and domain logic")
  Container(worker, "Background Worker", ".NET hosted services", "Reminders, notifications, imports, exports")
  ContainerDb(db, "Giddy database", "Azure SQL Database (Canada Central)", "Families, parties, guests, bookings, audit")
  ContainerQueue(bus, "Message bus", "Azure Service Bus", "Domain events and notification jobs")
}
System_Ext(email, "Email provider", "Sends transactional and marketing email")
System_Ext(sms, "SMS provider", "Sends text messages and receives STOP replies")
System_Ext(push, "Web Push service", "Browser push delivery (VAPID)")

Rel(api, bus, "Notification jobs", "AMQP")
Rel(worker, bus, "Consumes", "AMQP")
Rel(worker, db, "Preferences", "EF Core")
Rel(worker, email, "Send", "HTTPS")
Rel(worker, sms, "Send", "HTTPS")
Rel(worker, push, "Send", "Web Push")
Rel(sms, api, "STOP replies", "HTTPS")
@enduml
