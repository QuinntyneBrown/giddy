@startuml
title UML sequence behaviour — Push — explain, then ask
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "PushPrompt" as page
  participant "PushService" as svc
end box
box "Backend — Giddy API application" #D1FADF
  participant "PushSubscriptionsController" as ctrl
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
page --> actor : "Get a buzz when friends RSVP?"
actor -> page : Turn on
page -> svc : requestPermission()
alt granted
  svc -> svc : pushManager.subscribe(VAPID)
  svc -> ctrl : POST /api/push-subscriptions
  ctrl -> db : Save
  page --> actor : "Notifications on" + quiet hours
else denied/blocked
  page --> actor : Warning with steps to allow in browser settings
end
@enduml
