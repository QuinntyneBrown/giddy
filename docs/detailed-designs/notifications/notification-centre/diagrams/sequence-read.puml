@startuml
title UML sequence behaviour — Notifications — open and mark read
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "NotificationsPage" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "NotificationsController" as ctrl
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Open notifications
page -> ctrl : GET /api/notifications
ctrl -> db : Last 90 days, unread first
ctrl --> page : Items
actor -> page : Mark all as read
page -> ctrl : POST /read-all
ctrl -> db : Update
ctrl --> page : 204
page --> actor : Badge cleared
@enduml
