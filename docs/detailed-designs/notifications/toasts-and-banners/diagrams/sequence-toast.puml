@startuml
title UML sequence behaviour — Toasts — timers and limits
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "Feature page" as page
  participant "ToastService" as ts
  participant "ToastRegion" as tr
end box
page -> ts : show(success "Ethan Kim removed", Undo)
ts -> tr : Render (8 s timer)
actor -> tr : Hover
tr -> ts : pause
actor -> tr : Leave
tr -> ts : resume
page -> ts : show(danger "2 reminders didn't send")
ts -> tr : Render role=alert, no timer
page -> ts : show(4th toast)
ts -> tr : Remove oldest non-danger
@enduml
