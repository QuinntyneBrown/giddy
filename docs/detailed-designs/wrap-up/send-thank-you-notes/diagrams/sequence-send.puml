@startuml
title UML sequence behaviour — Wrap-up — send thank-you notes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "WrapUpPage" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "ThankYouController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "SendThankYousHandler" as h
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
  queue "Message bus" as bus
end box
actor -> page : Send 12 notes
page -> ctrl : POST /thank-yous/send
ctrl -> h : SendThankYousCommand
h -> db : Unsent notes for guests who came
h -> bus : One email job per note
h -> db : State = Queued
h --> ctrl : 12
ctrl --> page : 202
page --> actor : "14 of 14 sent" after deliveries
@enduml
