@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Send thank-you notes

ContainerDb(db, "Giddy database", "Azure SQL Database (Canada Central)", "Families, parties, guests, bookings, audit")
ContainerQueue(bus, "Message bus", "Azure Service Bus", "Domain events and notification jobs")
Container_Boundary(api_b, "Giddy API") {
  Component(ctrl, "ThankYouController", "ASP.NET Core controller", "Notes endpoints")
  Component(draft, "ThankYouDrafter", "Application service", "Drafts notes")
  Component(h, "SendThankYousHandler", "MediatR handler", "Queues emails")
  Component(note, "ThankYouNote", "Domain entity", "Draft or sent")
}

Rel(ctrl, draft, "Draft")
Rel(ctrl, h, "SendThankYousCommand")
Rel(h, note, "MarkQueued")
Rel(h, bus, "Jobs", "AMQP")
Rel(h, db, "Saves", "EF Core")
@enduml
