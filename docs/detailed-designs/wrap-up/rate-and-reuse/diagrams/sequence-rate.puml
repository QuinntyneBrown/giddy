@startuml
title UML sequence behaviour — Wrap-up — rate a booked venue
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "RatingStars" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "RatingsController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "RateProviderHandler" as h
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : 5 stars for Dino Den
page -> ctrl : PUT /ratings/{venueId} {stars: 5}
ctrl -> h : RateProviderCommand
h -> db : Confirmed booking for this party?
alt eligible
  h -> db : Upsert rating; update public average
  h --> ctrl : 200
else not booked
  h --> ctrl : 403
end
ctrl --> page : Result
page --> actor : Stars pressed
@enduml
