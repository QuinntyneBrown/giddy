@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Propose a priced plan

Person(parent, "Parent", "Plans kids' birthday parties with Giddy")
System(giddy, "Giddy", "Agentic kids' birthday planner for the GTA")
System_Ext(llm, "Anthropic Claude API", "Large language model behind the planning agent")
System_Ext(venues, "Venue partner APIs", "Live venue availability, holds and bookings")
System_Ext(vendors, "Vendor directory", "Entertainers, caterers and bakeries with quotes")

Rel(parent, giddy, "Uses")
Rel(giddy, llm, "Generates replies with", "HTTPS")
Rel(giddy, venues, "Checks availability with", "HTTPS")
Rel(giddy, vendors, "Checks vendors with", "HTTPS")
@enduml
