@startuml
title UML sequence behaviour — Memory — forget a fact
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "MemoryChips" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "MemoriesController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "ForgetMemoryHandler" as h
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
  database "Cache" as cache
end box
actor -> page : Forget: prefers venues with parking
page -> ctrl : DELETE /api/memories/{id}
ctrl -> ctrl : Same family? else 404 (L2-069)
ctrl -> h : ForgetMemoryCommand
h -> db : Delete memory
h -> cache : Evict context:{familyId}
h --> ctrl : NoContent
ctrl --> page : 204
page --> actor : Chip removed
@enduml
