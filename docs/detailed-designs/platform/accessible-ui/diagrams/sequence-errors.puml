@startuml
title UML sequence behaviour — Accessibility — submit a form with errors
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "Form page" as page
  participant "FormErrorSummary" as sum
  participant "LiveAnnouncer" as ann
end box
actor -> page : Submit with 2 errors
page -> page : Mark controls aria-invalid, link errors via aria-describedby
page -> sum : Show(errors)
sum -> sum : focus()
sum -> ann : Announce "Let's fix a couple of things"
actor -> sum : Follow link
sum -> page : Focus the field
@enduml
