@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Performance, capacity and resilience

Person(parent, "Parent", "Plans kids' birthday parties with Giddy")
System_Boundary(giddy, "Giddy") {
  Container(web, "Giddy Web", "Angular SPA + service worker", "Parent and guest UI, installable PWA")
  Container(api, "Giddy API", "ASP.NET Core", "REST endpoints, SignalR hub, application and domain logic")
  Container(agent, "Planning Agent", "ASP.NET Core worker", "Runs Giddy's tool-using conversation loop")
  Container(worker, "Background Worker", ".NET hosted services", "Reminders, notifications, imports, exports")
  ContainerDb(db, "Giddy database", "Azure SQL Database (Canada Central)", "Families, parties, guests, bookings, audit")
  ContainerDb(cache, "Cache", "Azure Cache for Redis", "Availability cache, SignalR backplane, rate limits")
  ContainerQueue(bus, "Message bus", "Azure Service Bus", "Domain events and notification jobs")
}
System_Ext(venues, "Venue partner APIs", "Live venue availability, holds and bookings")
System_Ext(vendors, "Vendor directory", "Entertainers, caterers and bakeries with quotes")
System_Ext(pay, "Payment provider", "PCI DSS Level 1 card processing and hosted fields")
System_Ext(email, "Email provider", "Sends transactional and marketing email")
System_Ext(sms, "SMS provider", "Sends text messages and receives STOP replies")
System_Ext(llm, "Anthropic Claude API", "Large language model behind the planning agent")

Rel(parent, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, cache, "Output cache", "RESP")
Rel(api, venues, "With circuit breaker", "HTTPS")
Rel(api, pay, "With timeout", "HTTPS")
Rel(agent, llm, "With timeout", "HTTPS")
Rel(worker, email, "Retries", "HTTPS")
@enduml
