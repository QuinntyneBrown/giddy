@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Performance, capacity and resilience

ContainerDb(cache, "Cache", "Azure Cache for Redis", "Availability cache, SignalR backplane, rate limits")
ContainerDb(db, "Giddy database", "Azure SQL Database (Canada Central)", "Families, parties, guests, bookings, audit")
System_Ext(venues, "Venue partner APIs", "Live venue availability, holds and bookings")
Container_Boundary(api_b, "Giddy API") {
  Component(res, "ResiliencePipelines", "Polly", "Timeout, retry, circuit breaker")
  Component(oc, "OutputCache", "ASP.NET Core", "Cached reads")
  Component(cc, "ConcurrencyTokens", "EF Core", "rowversion + If-Match")
  Component(adapters, "Provider adapters", "HTTP clients", "Venues, vendors, payments")
}

Rel(adapters, res, "Wrapped by")
Rel(res, venues, "HTTPS")
Rel(oc, cache, "RESP")
Rel(cc, db, "UPDATE … WHERE rowversion", "EF Core")
@enduml
