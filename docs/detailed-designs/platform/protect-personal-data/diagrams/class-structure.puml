@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Protect personal data and keep an audit trail

class AuditRecord {
  +long Id
  +DateTimeOffset At
  +Guid? ActorId
  +string Action
  +string Target
  +string Ip
}
class AuditWriter {
  +Write(action: string, target: string): Task
}
class DataSharingPolicy {
  +CanShareAllergies(partyId: Guid, recipient: Recipient): bool
}
class PiiRedactingEnricher {
  +Enrich(e: LogEvent): void
}
AuditWriter ..> AuditRecord : appends
@enduml
