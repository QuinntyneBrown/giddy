@startuml
title UML sequence behaviour — States — one section through loading, error and retry
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "Section" as page
  participant "ResourceState" as rs
end box
box "Backend — Giddy API application" #D1FADF
  participant "Endpoint" as ctrl
end box
page -> rs : load()
rs -> ctrl : GET
rs -> page : after 300 ms → skeleton (aria-busy)
ctrl --> rs : 503 ProblemDetails {reference}
rs --> page : status = error
page --> actor : Error block: what failed, data safe, Try again, reference
actor -> page : Try again
page -> rs : retry()
rs -> ctrl : GET
ctrl --> rs : 200 []
rs --> page : status = empty
page --> actor : Empty state with one action
@enduml
