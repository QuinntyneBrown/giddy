@startuml
title UML sequence behaviour — Create a party — submit the basics
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "NewPartyPage" as page
  participant "PartiesApi" as client
end box
box "Backend — Giddy API application" #D1FADF
  participant "PartiesController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "CreatePartyHandler" as h
  participant "Party" as ent
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Zuri, Sat 14 Nov, 16 kids, Afternoon, $800, M4M
page -> client : POST /api/parties
client -> ctrl : HTTPS request
ctrl -> h : CreatePartyCommand
h -> h : Validate date >= tomorrow (America/Toronto), 1 <= kids <= 60
alt invalid
  h --> ctrl : ValidationProblem
  ctrl --> page : 400; inputs kept
else valid
  h -> ent : Create (creator = Owner)
  h -> db : Save
  h --> ctrl : Created(id)
  ctrl --> client : 201 Location
  client --> page : Navigate /plan/chat?party=id
end
page --> actor : Result
@enduml
