@startuml
title UML sequence behaviour — Manage children — add a child
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "AddChildDialog" as page
  participant "FamilyApi" as client
end box
box "Backend — Giddy API application" #D1FADF
  participant "FamilyController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "SaveChildHandler" as h
  participant "Family" as ent
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Enter Kofi, 3 Feb 2023, 3 interests
page -> page : Block a 6th interest ("Pick up to 5")
page -> client : POST /api/family/children
client -> ctrl : HTTPS request
ctrl -> h : SaveChildCommand
h -> h : Validate name, birthday < today, interests <= 5
alt invalid
  h --> ctrl : ValidationProblem
  ctrl --> client : 400 field errors
  client --> page : Inline errors + summary
else valid
  h -> db : Load Family
  h -> ent : AddChild()
  h -> db : Save
  h --> ctrl : Created
  ctrl --> client : 201
  client --> page : Close dialog, show "Turns 4 · in 101 days"
end
@enduml
