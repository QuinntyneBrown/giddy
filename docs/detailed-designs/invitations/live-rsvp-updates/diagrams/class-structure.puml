@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Live RSVP updates and the allergy list

class RsvpChanged {
  +Guid PartyId
  +Guid GuestId
  +string ChildName
  +RsvpStatus Status
  +string? NewAllergy
}
class AllergyList {
  +List<AllergyEntry> Entries
  +DateTimeOffset? SharedAt
}
class AllergyEntry {
  +string ChildFirstName
  +string Allergy
}
class ShareAllergyListHandler {
  +Handle(cmd: ShareAllergyListCommand): Task<Result>
}
AllergyList "1" *-- "*" AllergyEntry
RsvpChangedHandler ..> RsvpChanged
ShareAllergyListHandler --> AllergyList
@enduml
