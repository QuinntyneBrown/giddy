@startuml
title UML sequence behaviour — Vendors — request and receive a quote
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "RequestQuoteDialog" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "VendorsController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "RequestQuoteHandler" as h
  participant "QuoteReceivedHandler" as recv
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  participant "Vendor directory" as vendors
  database "Giddy database" as db
  queue "Message bus" as bus
end box
actor -> page : Send request (Bubble Bianca, 2:15 pm)
page -> ctrl : POST /api/parties/{id}/quotes
ctrl -> h : RequestQuoteCommand
h -> db : Venue booking window; pending request in last 24 h?
alt outside window or duplicate
  h --> ctrl : ValidationProblem
  ctrl --> page : 400 / 409 with explanation
else ok
  h -> vendors : Quote request
  h -> db : QuoteRequest = Requested
  h --> ctrl : Created
  ctrl --> page : Success: "Most vendors reply within a day"
end
... later ...
vendors -> recv : Webhook quote $210, expires Tue 27 Oct
recv -> db : Quote + budget line "Quoted"
recv -> bus : QuoteReceived → notification
@enduml
