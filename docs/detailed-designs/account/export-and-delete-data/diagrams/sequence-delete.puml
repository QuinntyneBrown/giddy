@startuml
title UML sequence behaviour — Privacy — delete my account
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Backend — Giddy API application" #D1FADF
  participant "PrivacyController" as ctrl
end box
box "Backend — Background Worker application" #ECFDF3
  participant "DeleteAccountJob" as job
  participant "FamilyDataGraph" as graph
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
  database "File storage" as blob
end box
actor -> ctrl : POST /api/privacy/delete-account {typedEmail}
ctrl -> ctrl : Email matches? Warn about live bookings
ctrl -> db : Sign out all sessions; mark pending deletion
ctrl -> job : DeletionRequested
job -> graph : Delete(familyId)
graph -> db : Revoke co-planner access; delete parties, guests, conversations, memories
graph -> blob : Delete files
graph --> job : DeletionReport (payments retained)
@enduml
