@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Work offline on party day

class OutboxEntry {
  +string Id
  +string Method
  +string Url
  +string Body
  +string IfMatch
  +number CreatedAt
}
class SyncService {
  +replay(): Promise<SyncResult>
}
class SyncResult {
  +number Synced
  +Conflict[] Conflicts
}
class Conflict {
  +string ItemId
  +unknown Mine
  +unknown Theirs
}
SyncService ..> OutboxEntry
SyncService ..> SyncResult
SyncResult "1" *-- "*" Conflict
@enduml
