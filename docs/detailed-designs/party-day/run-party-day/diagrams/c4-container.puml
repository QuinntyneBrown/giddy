@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Run the party day

Person(parent, "Parent", "Plans kids' birthday parties with Giddy")
System_Boundary(giddy, "Giddy") {
  Container(web, "Giddy Web", "Angular SPA + service worker", "Parent and guest UI, installable PWA")
  Container(api, "Giddy API", "ASP.NET Core", "REST endpoints, SignalR hub, application and domain logic")
  ContainerDb(db, "Giddy database", "Azure SQL Database (Canada Central)", "Families, parties, guests, bookings, audit")
}

Rel(parent, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
@enduml
