@startuml
title UML sequence behaviour — Budget — add a cost
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "AddExpenseDialog" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "BudgetController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "SaveCostLineHandler" as h
  participant "Budget" as ent
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : "Dino balloons and banner", $22, Decorations
page --> actor : Preview "$0 left"
page -> ctrl : POST /api/parties/{id}/budget/lines
ctrl -> h : SaveCostLineCommand
h -> h : Amount > 0, <= 2 decimals
alt invalid
  h --> ctrl : ValidationProblem
  ctrl --> page : 400 "Enter an amount like 35 or 35.50"
else valid
  h -> db : Load Budget
  h -> ent : AddLine
  h -> db : Save
  h --> ctrl : Updated totals
  ctrl --> page : 201
  page --> actor : Table and meter updated
end
@enduml
