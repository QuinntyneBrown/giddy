@startuml
title UML sequence behaviour — Checklist — tick a task
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "ChecklistPage" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "TasksController" as ctrl
  participant "PartyHub" as hub
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "CompleteTaskHandler" as h
  participant "PartyTask" as ent
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Tick "Confirm Professor Fizz booking"
page -> page : Optimistic move to Done
page -> ctrl : POST /tasks/{taskId}/complete
ctrl -> h : CompleteTaskCommand
h -> ent : Complete()
h -> db : Save
h -> hub : task.changed to party group
hub --> page : Co-planners' pages update (<= 5 s)
h --> ctrl : Readiness 70%
ctrl --> page : 200
page --> actor : Progress and readiness updated
@enduml
