@startuml
title UML sequence behaviour — Sign in — email and password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "SignInPage" as page
  participant "AuthApi" as client
end box
box "Backend — Giddy API application" #D1FADF
  participant "RateLimiter" as rl
  participant "AuthController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "SignInCommandHandler" as h
  participant "SessionService" as sess
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Cache" as cache
  database "Giddy database" as db
end box
actor -> page : Submit email and password
page -> client : POST /api/auth/sign-in
client -> rl : HTTPS request
rl -> cache : Increment IP and account counters
cache --> rl : Under 10/min
rl -> ctrl : Admit
ctrl -> h : Send SignInCommand
h -> db : Load account and failure history
db --> h : Account
alt paused (5 failures in 15 min)
  h --> ctrl : Result.Paused
  ctrl --> client : 423 with retry time (L2-004)
else password wrong
  h -> db : Record failure
  h --> ctrl : Result.Invalid
  ctrl --> client : 401 "That email and password don't match"
else password correct
  h -> sess : Issue session (30 days if kept)
  sess -> db : Save session
  h --> ctrl : SessionTicket
  ctrl --> client : 200 + HttpOnly Secure SameSite=Lax cookie
  client --> page : Navigate to return URL or /home
end
page --> actor : Result
@enduml
