@startuml
title UML sequence behaviour — Sign up — confirm the email address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "VerifyEmailPage" as page
  participant "AuthApi" as client
end box
box "Backend — Giddy API application" #D1FADF
  participant "AuthController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "VerifyEmailCommandHandler" as h
  participant "Parent" as ent
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Open link /verify-email?token=…
page -> client : POST /api/auth/verify
client -> ctrl : HTTPS request
ctrl -> h : Send VerifyEmailCommand
h -> db : Load token by hash
db --> h : Token
alt token valid and unused (24 h)
  h -> ent : MarkEmailVerified()
  h -> db : Save, mark token used
  h --> ctrl : Success + session
  ctrl --> client : 200 + session cookie
  client --> page : Success state
  page --> actor : "You're in" → family setup
else expired or used
  h --> ctrl : Result.Expired
  ctrl --> client : 410 Gone (ProblemDetails)
  client --> page : Expired state with "Send a new link"
end
@enduml
