@startuml
title UML sequence behaviour — Session — expiry during a task
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "SessionInterceptor" as int
  participant "SessionExpiredDialog" as dlg
end box
box "Backend — Giddy API application" #D1FADF
  participant "SessionMiddleware" as mw
  participant "AuthController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "SessionService" as sess
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> int : Save a guest (any request)
int -> mw : HTTPS request
mw -> sess : Validate session
sess --> mw : Expired
mw --> int : 401 session_expired
int -> dlg : Open "Still there?"
actor -> dlg : Enter password
dlg -> ctrl : POST /api/auth/reauthenticate
ctrl -> sess : Issue new session
ctrl --> dlg : 200 + cookie
dlg -> int : Replay pending request
int -> mw : Original request
mw --> int : 200
int --> actor : Guest saved; input kept
@enduml
