@startuml
title UML sequence behaviour — Reset password — set a new password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Giddy Web application" #E0F2FE
  participant "ResetPasswordPage" as page
end box
box "Backend — Giddy API application" #D1FADF
  participant "PasswordController" as ctrl
end box
box "Backend — Giddy Application and Domain" #ECFDF3
  participant "ResetPasswordHandler" as h
  participant "SessionService" as sess
end box
box "Backend — Giddy Infrastructure" #FFF4E5
  database "Giddy database" as db
end box
actor -> page : Enter new password twice
page -> ctrl : POST /api/auth/password/reset
ctrl -> h : ResetPasswordCommand
h -> db : Load token by hash
alt valid (30 min, unused)
  h -> h : Validate rules, match confirmation
  h -> db : Update hash, mark token used, clear pause
  h -> sess : RevokeAll(except new session)
  h --> ctrl : Success
  ctrl --> page : 200 + session cookie
  page --> actor : "Password updated"
else expired or used
  h --> ctrl : Expired
  ctrl --> page : 410 Gone
  page --> actor : "This link has expired" + new link
end
@enduml
